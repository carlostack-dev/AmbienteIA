# AmbienteIA — variaveis de ambiente (EXEMPLO / template)
# Copie este arquivo para .env e preencha com suas credenciais reais.
# NUNCA publique o .env real contendo chaves de API.

# =============================================================================
# Provedor de LLM (NVIDIA NIM)
# =============================================================================
# Obtenha sua chave em: https://build.nvidia.com/
NVIDIA_API_KEY=sua_chave_aqui

# URL base do proxy Headroom local (ajustado pelo AmbienteIA automaticamente)
NVIDIA_BASE_URL=http://127.0.0.1:8787/v1
