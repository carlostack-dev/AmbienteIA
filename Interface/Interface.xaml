<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AmbienteIA - Central de Controle"
        Width="1200" Height="820" MinWidth="1000" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="#0B0B14"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

  <Window.Resources>
    <!-- Paleta -->
    <SolidColorBrush x:Key="SurfaceBrush" Color="#13131F"/>
    <SolidColorBrush x:Key="SurfaceDeepBrush" Color="#0E0E18"/>
    <SolidColorBrush x:Key="LineBrush" Color="#2B2447"/>
    <SolidColorBrush x:Key="VioletBrush" Color="#8B5CF6"/>
    <SolidColorBrush x:Key="VioletSoftBrush" Color="#C4B5FD"/>
    <SolidColorBrush x:Key="TextBrush" Color="#F3F4F6"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#9CA3AF"/>
    <SolidColorBrush x:Key="NvidiaBrush" Color="#76B900"/>

    <!-- Cartao -->
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="16"/>
      <Setter Property="Padding" Value="18"/>
      <Setter Property="MinHeight" Value="200"/>
    </Style>

    <!-- Moldura circular da logo -->
    <Style x:Key="LogoFrame" TargetType="Border">
      <Setter Property="Width" Value="52"/>
      <Setter Property="Height" Value="52"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Background" Value="#1A1530"/>
      <Setter Property="BorderBrush" Value="#3B2E6B"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <Style x:Key="MonoChip" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource SurfaceDeepBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="10,5"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="Margin" Value="0,14,0,0"/>
    </Style>

    <!-- Template compartilhado dos botoes -->
    <ControlTemplate x:Key="PillButtonTemplate" TargetType="Button">
      <Grid>
        <Border x:Name="Bd"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="12"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <Border x:Name="Overlay" Background="White" CornerRadius="12" Opacity="0" IsHitTestVisible="False"/>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter TargetName="Overlay" Property="Opacity" Value="0.10"/>
        </Trigger>
        <Trigger Property="IsPressed" Value="True">
          <Setter TargetName="Overlay" Property="Opacity" Value="0.20"/>
        </Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True">
          <Setter TargetName="Bd" Property="BorderBrush" Value="#C4B5FD"/>
        </Trigger>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Opacity" Value="0.40"/>
        </Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Template" Value="{StaticResource PillButtonTemplate}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Background">
        <Setter.Value>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#8B5CF6" Offset="0"/>
            <GradientStop Color="#6D28D9" Offset="1"/>
          </LinearGradientBrush>
        </Setter.Value>
      </Setter>
      <Setter Property="BorderBrush" Value="#A78BFA"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="20,13"/>
      <Setter Property="Margin" Value="0,0,12,12"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    </Style>

    <Style x:Key="DangerButton" TargetType="Button">
      <Setter Property="Template" Value="{StaticResource PillButtonTemplate}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Background">
        <Setter.Value>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#EF4444" Offset="0"/>
            <GradientStop Color="#B91C1C" Offset="1"/>
          </LinearGradientBrush>
        </Setter.Value>
      </Setter>
      <Setter Property="BorderBrush" Value="#FCA5A5"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="20,13"/>
      <Setter Property="Margin" Value="0,0,12,12"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button">
      <Setter Property="Template" Value="{StaticResource PillButtonTemplate}"/>
      <Setter Property="Foreground" Value="#E5E7EB"/>
      <Setter Property="Background" Value="#181826"/>
      <Setter Property="BorderBrush" Value="#3B2E6B"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="16,13"/>
      <Setter Property="Margin" Value="0,0,12,12"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    </Style>

    <Style x:Key="GlyphText" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="Margin" Value="0,0,10,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="CardTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="17"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="Margin" Value="0,16,0,2"/>
    </Style>

    <Style x:Key="CardSub" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
    </Style>

    <Style x:Key="MetricValue" TargetType="TextBlock">
      <Setter Property="FontSize" Value="20"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/>
    </Style>

    <Style x:Key="MetricLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      <Setter Property="Margin" Value="0,2,0,0"/>
    </Style>

    <Style x:Key="StatusText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="MonoText" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Foreground" Value="{StaticResource VioletSoftBrush}"/>
    </Style>

    <Style x:Key="ListItem" TargetType="ListBoxItem">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="6,2"/>
      <Setter Property="Margin" Value="0,2,0,0"/>
      <Setter Property="Foreground" Value="#E5E7EB"/>
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
  </Window.Resources>

  <Grid>
    <!-- Brilho sutil no topo -->
    <Border VerticalAlignment="Top" Height="220" IsHitTestVisible="False">
      <Border.Background>
        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
          <GradientStop Color="#2A1B5C" Offset="0"/>
          <GradientStop Color="#000B0B14" Offset="1"/>
        </LinearGradientBrush>
      </Border.Background>
    </Border>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Grid Margin="28,24,28,24">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- CABECALHO -->
      <Grid Grid.Row="0" Margin="0,0,0,18">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Width="68" Height="68" CornerRadius="18" Background="#1A1530"
                BorderBrush="#4C3A8A" BorderThickness="1" Margin="0,0,18,0">
          <Image x:Name="HeaderLogo" Stretch="Uniform" Margin="6"
                 RenderOptions.BitmapScalingMode="HighQuality"/>
        </Border>

        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="AMBIENTEIA" FontSize="27" FontWeight="Bold">
            <TextBlock.Foreground>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#FFFFFF" Offset="0"/>
                <GradientStop Color="#C4B5FD" Offset="1"/>
              </LinearGradientBrush>
            </TextBlock.Foreground>
          </TextBlock>
          <TextBlock Text="Central de Controle - Ambiente Local de Agentes IA" FontSize="14" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
          <TextBlock Text="Hermes  →  Headroom  →  NVIDIA NIM" FontSize="12" Foreground="#7C6FB0" Margin="0,6,0,0"/>
        </StackPanel>

        <Border x:Name="OverallBadge" Grid.Column="2" CornerRadius="22" Padding="18,9"
                Background="#181826" BorderBrush="#3B2E6B" BorderThickness="1" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="OverallDot" Width="11" Height="11" Fill="#64748B" Margin="0,0,10,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="OverallText" Text="CHECKING" Style="{StaticResource StatusText}" FontSize="13"/>
          </StackPanel>
        </Border>
      </Grid>

      <!-- PROGRESSO -->
      <StackPanel Grid.Row="1" Margin="0,0,0,18">
        <ProgressBar x:Name="Progress" Height="4" Minimum="0" Maximum="100" Value="0"
                     Foreground="#8B5CF6" Background="#1E1B33" BorderThickness="0"/>
        <TextBlock x:Name="PhaseText" Text="Pronto." FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/>
      </StackPanel>

      <!-- CARTOES DE STATUS -->
      <Grid Grid.Row="2" Margin="0,0,0,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- HEADROOM -->
        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0">
          <StackPanel>
            <Grid>
              <Border Style="{StaticResource LogoFrame}">
                <Image x:Name="HeadroomLogo" Stretch="Uniform" Margin="5" RenderOptions.BitmapScalingMode="HighQuality"/>
              </Border>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,0,0">
                <Ellipse x:Name="HeadroomDot" Width="10" Height="10" Fill="#64748B" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="HeadroomStatus" Text="CHECKING" Style="{StaticResource StatusText}"/>
              </StackPanel>
            </Grid>
            <TextBlock Text="HEADROOM" Style="{StaticResource CardTitle}"/>
            <TextBlock Text="Proxy de contexto - porta 8787" Style="{StaticResource CardSub}"/>
            <Border Style="{StaticResource MonoChip}">
              <TextBlock Text="127.0.0.1:8787" Style="{StaticResource MonoText}"/>
            </Border>
            <TextBlock x:Name="HeadroomDetail" Text="" Style="{StaticResource CardSub}" Margin="0,10,0,0" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>

        <!-- NVIDIA NIM -->
        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,8,0">
          <StackPanel>
            <Grid>
              <Border Style="{StaticResource LogoFrame}">
                <Image x:Name="NvidiaLogo" Stretch="Uniform" Margin="5" RenderOptions.BitmapScalingMode="HighQuality"/>
              </Border>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,0,0">
                <Ellipse x:Name="NvidiaDot" Width="10" Height="10" Fill="#64748B" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="NvidiaStatus" Text="CHECKING" Style="{StaticResource StatusText}"/>
              </StackPanel>
            </Grid>
            <TextBlock Text="NVIDIA NIM" Style="{StaticResource CardTitle}"/>
            <TextBlock Text="Endpoint de modelos NVIDIA" Style="{StaticResource CardSub}"/>
            <Border Style="{StaticResource MonoChip}">
              <TextBlock Text="integrate.api.nvidia.com" Style="{StaticResource MonoText}"/>
            </Border>
            <TextBlock x:Name="NvidiaDetail" Text="" Style="{StaticResource CardSub}" Margin="0,10,0,0" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>

        <!-- HERMES -->
        <Border Grid.Column="2" Style="{StaticResource Card}" Margin="8,0,0,0">
          <StackPanel>
            <Grid>
              <Border Style="{StaticResource LogoFrame}">
                <Image x:Name="HermesLogo" Stretch="Uniform" Margin="5" RenderOptions.BitmapScalingMode="HighQuality"/>
              </Border>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,0,0">
                <Ellipse x:Name="HermesDot" Width="10" Height="10" Fill="#64748B" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="HermesStatus" Text="CHECKING" Style="{StaticResource StatusText}"/>
              </StackPanel>
            </Grid>
            <TextBlock Text="HERMES AGENT" Style="{StaticResource CardTitle}"/>
            <TextBlock Text="Agente de linha de comando" Style="{StaticResource CardSub}"/>
            <Border Style="{StaticResource MonoChip}">
              <TextBlock Text="C:\Projetos" Style="{StaticResource MonoText}"/>
            </Border>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
              <Image x:Name="NvidiaModelIcon" Width="18" Height="18" Stretch="Uniform" Margin="0,0,8,0"
                     RenderOptions.BitmapScalingMode="HighQuality"/>
              <TextBlock x:Name="ModelText" Text="nvidia/nemotron-3.5-super-vl-120b-a12b" Style="{StaticResource CardSub}" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock x:Name="HermesDetail" Text="" Style="{StaticResource CardSub}" Margin="0,4,0,0" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
      </Grid>

      <!-- CARTOES DE METRICAS -->
      <Grid Grid.Row="3" Margin="0,0,0,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource Card}" MinHeight="120" Margin="0,0,8,0">
          <StackPanel>
            <TextBlock Text="REQUISICOES" Style="{StaticResource CardSub}" Margin="0,0,0,4"/>
            <TextBlock x:Name="MetricRequests" Text="0" Style="{StaticResource MetricValue}"/>
          </StackPanel>
        </Border>
        <Border Grid.Column="1" Style="{StaticResource Card}" MinHeight="120" Margin="8,0,8,0">
          <StackPanel>
            <TextBlock Text="TOKENS ECONOMIZADOS" Style="{StaticResource CardSub}" Margin="0,0,0,4"/>
            <TextBlock x:Name="MetricTokens" Text="0" Style="{StaticResource MetricValue}"/>
          </StackPanel>
        </Border>
        <Border Grid.Column="2" Style="{StaticResource Card}" MinHeight="120" Margin="8,0,8,0">
          <StackPanel>
            <TextBlock Text="LATENCIA MEDIA" Style="{StaticResource CardSub}" Margin="0,0,0,4"/>
            <TextBlock x:Name="MetricLatency" Text="0 ms" Style="{StaticResource MetricValue}"/>
          </StackPanel>
        </Border>
        <Border Grid.Column="3" Style="{StaticResource Card}" MinHeight="120" Margin="8,0,0,0">
          <StackPanel>
            <TextBlock Text="CONEXAO NVIDIA" Style="{StaticResource CardSub}" Margin="0,0,0,4"/>
            <TextBlock x:Name="MetricConnection" Text="--" Style="{StaticResource MetricValue}"/>
          </StackPanel>
        </Border>
      </Grid>

      <!-- BOTOES PRINCIPAIS -->
      <WrapPanel Grid.Row="4" Margin="0,0,0,8">
        <Button x:Name="StartButton" Style="{StaticResource PrimaryButton}" MinWidth="180">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource GlyphText}" Text="&#xE768;"/>
            <TextBlock Text="INICIAR AMBIENTE" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button x:Name="StopButton" Style="{StaticResource DangerButton}" MinWidth="140">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource GlyphText}" Text="&#xE74A;"/>
            <TextBlock Text="PARAR" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button x:Name="OpenHermesButton" Style="{StaticResource SecondaryButton}" MinWidth="160"
                ToolTip="Disponível quando o Headroom estiver saudável.">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource GlyphText}" Text="&#xE756;"/>
            <TextBlock Text="ABRIR HERMES" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button x:Name="OpenFolderButton" Style="{StaticResource SecondaryButton}" MinWidth="180">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource GlyphText}" Text="&#xED25;"/>
            <TextBlock Text="ABRIR C:\PROJETOS" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button x:Name="DiagButton" Style="{StaticResource SecondaryButton}" MinWidth="150">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource GlyphText}" Text="&#xE9D9;"/>
            <TextBlock Text="DIAGNÓSTICO" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button x:Name="TestNvidiaButton" Style="{StaticResource SecondaryButton}" MinWidth="150">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource GlyphText}" Text="&#xE716;"/>
            <TextBlock Text="TESTAR NVIDIA" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button x:Name="TestHeadroomButton" Style="{StaticResource SecondaryButton}" MinWidth="160">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource GlyphText}" Text="&#xE716;"/>
            <TextBlock Text="TESTAR HEADROOM" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button x:Name="StatsButton" Style="{StaticResource SecondaryButton}" MinWidth="140">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource GlyphText}" Text="&#xE790;"/>
            <TextBlock Text="ATUALIZAR ESTATS" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button x:Name="OpenLogsButton" Style="{StaticResource SecondaryButton}" MinWidth="120">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource GlyphText}" Text="&#xE71E;"/>
            <TextBlock Text="LOGS" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button x:Name="OpenConfigButton" Style="{StaticResource SecondaryButton}" MinWidth="170">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource GlyphText}" Text="&#xE715;"/>
            <TextBlock Text="CONFIG HERMES" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button x:Name="ExitButton" Style="{StaticResource SecondaryButton}" MinWidth="170"
                ToolTip="Fecha apenas esta interface. Os serviços continuam rodando.">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource GlyphText}" Text="&#xE7E8;"/>
            <TextBlock Text="ENCERRAR INTERFACE" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
      </WrapPanel>

      <!-- LOG DE EVENTOS -->
      <Border Grid.Row="5" Style="{StaticResource Card}" Padding="0" MinHeight="140">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Text="LOG DE EVENTOS" FontSize="11" FontWeight="Bold"
                     Foreground="#7C6FB0" Margin="18,14,18,8"/>
          <RichTextBox x:Name="LogBox" Grid.Row="1" IsReadOnly="True" Margin="10,0,10,10"
                       Background="#0E0E18" BorderThickness="0"
                       Foreground="#E5E7EB" Padding="14,6,14,10"
                       FontFamily="Cascadia Mono, Consolas" FontSize="12.5"
                       ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
        </Grid>
      </Border>

      <!-- PAINEL INFERIOR: ULTIMOS ERROS + HISTORICO -->
      <Grid Grid.Row="6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ULTIMOS ERROS -->
        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0" Padding="0" MinHeight="160">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="ÚLTIMOS ERROS" FontSize="11" FontWeight="Bold"
                       Foreground="#F87171" Margin="18,14,18,8"/>
            <ListBox x:Name="ErrorList" Grid.Row="1" Margin="10,0,10,10"
                     Background="#0E0E18" BorderThickness="0"
                     Foreground="#F87171" Padding="14,6,14,10"
                     FontFamily="Cascadia Mono, Consolas" FontSize="12"
                     ItemContainerStyle="{StaticResource ListItem}"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
          </Grid>
        </Border>

        <!-- HISTORICO DE ATIVIDADES -->
        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,0" Padding="0" MinHeight="160">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="HISTÓRICO DE ATIVIDADES" FontSize="11" FontWeight="Bold"
                       Foreground="#C4B5FD" Margin="18,14,18,8"/>
            <ListBox x:Name="HistoryList" Grid.Row="1" Margin="10,0,10,10"
                     Background="#0E0E18" BorderThickness="0"
                     Foreground="#E5E7EB" Padding="14,6,14,10"
                     FontFamily="Cascadia Mono, Consolas" FontSize="12"
                     ItemContainerStyle="{StaticResource ListItem}"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
          </Grid>
        </Border>
      </Grid>
      </Grid>
    </ScrollViewer>
  </Grid>
</Window>